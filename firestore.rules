rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function maxCommentLength() {
      return 2500;
    }

    function isValidComment(text) {
      return text is string &&
             text.size() > 0 &&
             text.size() < maxCommentLength();
    }

    // Users can read/write their own user document
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && 
                   request.auth.uid == userId && 
                   request.resource.data.uid == userId;
      
      // Additional validation for updates
      allow update: if (
        // Only allow updating specific fields
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'lastLogin', 'freeTierUsage'])
      );
    }
    
    // Users can read their own subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      // Write operations handled by Cloud Functions
      allow write: if false;
    }
    
    // Public read access to active plans
    match /plans/{planId} {
      allow read: if resource.data.isActive == true;
      // Write operations handled by admin
      allow write: if false;
    }
    
    // Users can access their own transaction logs
    match /transactions/{transactionId} {
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      // Create allowed for authenticated users with proper data
      allow create: if request.auth != null && 
                   request.resource.data.userId == request.auth.uid &&
                   request.resource.data.timestamp == request.time &&
                   request.resource.data.recordCount is number &&
                   request.resource.data.recordCount > 0;
    }
    
    // Comments collection
    match /comments/{commentId} {
      // Anyone can read comments
      allow read: if true;
      
      // Helper function to validate the structure and basic types of new comment data
      function isValidNewCommentData(data) {
        // 1. Validate core fields' presence and type
        let coreFieldsValid = isValidComment(data.text) && (data.createdAt is timestamp);

        // 2. Validate 'parentId' if present
        // It's valid if 'parentId' is not in data OR if it is in data and meets criteria.
        let parentIdValid = !('parentId' in data) || 
                            (('parentId' in data) && (data.parentId is string) && (data.parentId.size() > 0));

        // 3. Validate the set of keys to prevent extraneous fields
        let actualKeys = data.keys();
        let allowedKeysList = ['userId', 'text', 'createdAt', 'userName', 'parentId'];
        // Ensure all keys present in 'data' are within the 'allowedKeysList'.
        let allActualKeysAllowed = actualKeys.hasOnly(allowedKeysList);

        // 4. Calculate expected number of keys based on optional fields' presence
        let expectedSize = 3 + // userId, text, createdAt are mandatory for the purpose of this check
                           (('userName' in data) ? 1 : 0) +
                           (('parentId' in data) ? 1 : 0);
        
        let keyCountCorrect = actualKeys.size() == expectedSize;

        // All conditions must be true
        return coreFieldsValid && 
               parentIdValid && 
               allActualKeysAllowed &&
               keyCountCorrect;
      }

      // Anyone can create comments, provided they include the required fields
      // and adhere to user-specific (anonymous/authenticated) conditions.
      allow create: if 
        isValidNewCommentData(request.resource.data) &&
        (
          // Case 1: Anonymous User
          (request.auth == null &&
           request.resource.data.userId == 'anonymous' &&
           request.resource.data.userName is string && // userName is required for anonymous
           request.resource.data.userName.size() > 0
          )
          ||
          // Case 2: Authenticated User
          (request.auth != null &&
           request.resource.data.userId == request.auth.uid &&
           // userName is optional for authenticated; if present, must match token.name
           // if not present, auth.token.name must also be null.
           (
             (!('userName' in request.resource.data) && request.auth.token.name == null) ||
             (('userName' in request.resource.data) && request.resource.data.userName is string && request.resource.data.userName == request.auth.token.name)
           )
          )
        );
      
      // For now, disallow update and delete by clients directly
      allow update, delete: if false; 
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
