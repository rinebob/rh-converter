rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && 
                   request.auth.uid == userId && 
                   request.resource.data.uid == userId;
      
      // Additional validation for updates
      allow update: if (
        // Only allow updating specific fields
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'lastLogin', 'freeTierUsage'])
      );
    }
    
    // Users can read their own subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      // Write operations handled by Cloud Functions
      allow write: if false;
    }
    
    // Public read access to active plans
    match /plans/{planId} {
      allow read: if resource.data.isActive == true;
      // Write operations handled by admin
      allow write: if false;
    }
    
    // Users can access their own transaction logs
    match /transactions/{transactionId} {
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      // Create allowed for authenticated users with proper data
      allow create: if request.auth != null && 
                   request.resource.data.userId == request.auth.uid &&
                   request.resource.data.timestamp == request.time &&
                   request.resource.data.recordCount is number &&
                   request.resource.data.recordCount > 0;
    }
    
    // Comments collection
    match /comments/{commentId} {
      // Anyone can read comments
      allow read: if true;
      
      // Anyone can create comments, provided they include the required fields
      // We'll also check if the user is anonymous or authenticated
      allow create: if 
        // Common conditions
        request.resource.data.fileId is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() < 1000 &&
        // No specific value check for createdAt, but type check will be added
        (
          // Case 1: Anonymous User
          (request.auth == null &&
           request.resource.data.userId == 'anonymous' &&
           request.resource.data.userName is string &&
           request.resource.data.userName.size() > 0 &&
           request.resource.data.createdAt is timestamp
          )
          ||
          // Case 2: Authenticated User
          (request.auth != null &&
           request.resource.data.userId == request.auth.uid &&
           (
             (request.auth.token.name == null && !(request.resource.data.userName is string)) ||
             (request.auth.token.name is string && request.resource.data.userName == request.auth.token.name)
           ) &&
           request.resource.data.createdAt is timestamp
          )
        );
      
      // For now, disallow update and delete by clients directly
      allow update, delete: if false; 
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
