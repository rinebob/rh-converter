rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function maxCommentLength() {
      return 2500;
    }

    function isValidComment(text) {
      return text is string &&
             text.size() > 0 &&
             text.size() < maxCommentLength();
    }

    // Users can read/write their own user document
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && 
                   request.auth.uid == userId && 
                   request.resource.data.uid == userId;
      
      // Additional validation for updates
      allow update: if (
        // Only allow updating specific fields
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'lastLogin', 'freeTierUsage'])
      );
    }
    
    // Users can read their own subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      // Write operations handled by Cloud Functions
      allow write: if false;
    }
    
    // Public read access to active plans
    match /plans/{planId} {
      allow read: if resource.data.isActive == true;
      // Write operations handled by admin
      allow write: if false;
    }
    
    // Users can access their own transaction logs
    match /transactions/{transactionId} {
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      // Create allowed for authenticated users with proper data
      allow create: if request.auth != null && 
                   request.resource.data.userId == request.auth.uid &&
                   request.resource.data.timestamp == request.time &&
                   request.resource.data.recordCount is number &&
                   request.resource.data.recordCount > 0;
    }
    
    // Comments collection
    match /comments/{commentId} {
      // Anyone can read comments
      allow read: if true;
      
      // All writes to comments are performed by Cloud Functions using Admin SDK
      // Disallow direct client create/update/delete
      allow create, update, delete: if false;
    }

    // Private: comment metadata (never readable/writable from client)
    match /commentMeta/{commentId} {
      allow read, write: if false;
    }

    // Private: comment reports (details not public)
    match /commentReports/{reportId} {
      allow read, write: if false;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
